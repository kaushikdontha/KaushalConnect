{
  "name": "kaushalconnect",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @kaushalconnect/api run dev",
    "dev:web": "npm --workspace @kaushalconnect/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm --workspace @kaushalconnect/api run db:generate",
    "db:migrate": "npm --workspace @kaushalconnect/api run db:migrate",
    "db:deploy": "npm --workspace @kaushalconnect/api run db:deploy",
    "db:seed:demo": "npm --workspace @kaushalconnect/api run db:seed:demo",
    "worker": "npm --workspace @kaushalconnect/api run worker",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bullmq": "^5.61.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.1.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  }
}
