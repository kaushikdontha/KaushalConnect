{
  "name": "@kaushalconnect/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "db:generate": "node scripts/prisma.cjs generate",
    "db:migrate": "node scripts/prisma.cjs migrate dev --name init --skip-generate",
    "db:deploy": "node scripts/prisma.cjs migrate deploy",
    "db:seed:demo": "node --experimental-strip-types prisma/seed-demo.ts",
    "test": "node scripts/test.cjs",
    "worker:prod": "node dist/worker.js",
    "db:seed:fixtures": "tsx prisma/seed-fixtures.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bullmq": "^5.61.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.1.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.1",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6"
  }
}
