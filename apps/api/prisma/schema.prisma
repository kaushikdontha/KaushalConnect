generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  // The API stores this value in lowercase after trimming whitespace.
  email         String         @unique
  passwordHash  String
  role          UserRole
  skills        String[]       @default([])
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  jobs          Job[]          @relation("RecruiterJobs")
  applications  Application[]  @relation("CandidateApplications")
  notifications Notification[]
}

model Job {
  id             String        @id @default(uuid()) @db.Uuid
  recruiterId    String        @db.Uuid
  title          String
  description    String
  location       String
  requiredSkills String[]      @default([])
  deadline       DateTime @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  recruiter      User          @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Restrict)
  applications   Application[]

  @@index([recruiterId, createdAt])
  @@index([deadline])
}

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  jobId       String            @db.Uuid
  candidateId String            @db.Uuid
  coverNote   String            @default("")
  matchScore  Int
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId, status])
}

model Notification {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  applicationId String      @db.Uuid
  eventKey      String      @unique
  message       String
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}
